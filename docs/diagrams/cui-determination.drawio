<mxfile host="drawio"><diagram name="CUI determination" id="cui-det"><mxGraphModel dx="1500" dy="1150" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1080" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d1" value="e.g. g-code, routing, our pricing&lt;br&gt;&lt;br&gt;&lt;i&gt;Any part that copies CUI we received&lt;br&gt;goes down the government branch.&lt;br&gt;The rest stays ours.&lt;/i&gt;" style="rounded=1;arcSize=6;dashed=1;dashPattern=6 4;strokeWidth=3;strokeColor=#2E8B57;fillColor=none;fontColor=#333333;fontSize=14;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="330" height="170" as="geometry"/></mxCell><mxCell id="d2" value="e.g. an ITAR drawing from a&lt;br&gt;commercial OEM, with no DoD nexus" style="rounded=1;arcSize=6;dashed=1;dashPattern=6 4;strokeWidth=3;strokeColor=#5B7FA6;fillColor=none;fontColor=#333333;fontSize=14;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="1110" y="270" width="330" height="95" as="geometry"/></mxCell><mxCell id="d3" value="Decide on the evidence&lt;br&gt;Notify the source in writing&lt;br&gt;Protect it as CUI meanwhile" style="rounded=1;arcSize=6;dashed=1;dashPattern=6 4;strokeWidth=3;strokeColor=#E8B923;fillColor=none;fontColor=#333333;fontSize=14;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="330" height="120" as="geometry"/></mxCell><mxCell id="d4" value="Safeguard to NIST SP 800-171&lt;br&gt;Check marking: cui-marking-check" style="rounded=1;arcSize=6;dashed=1;dashPattern=6 4;strokeWidth=3;strokeColor=#9B6FB5;fillColor=none;fontColor=#333333;fontSize=14;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="585" y="840" width="330" height="110" as="geometry"/></mxCell><mxCell id="d5" value="Quotes, POs, clause pages, schedules&lt;br&gt;FAR 52.204-21 basic safeguarding" style="rounded=1;arcSize=6;dashed=1;dashPattern=6 4;strokeWidth=3;strokeColor=#777777;fillColor=none;fontColor=#333333;fontSize=14;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="1110" y="640" width="330" height="110" as="geometry"/></mxCell><mxCell id="q1" value="Who owns the data?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#555555;strokeColor=none;fontColor=#FFFFFF;fontSize=17;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="50" width="300" height="80" as="geometry"/></mxCell><mxCell id="q2" value="Does a CUI Registry authority&lt;br&gt;(law, regulation, government-wide&lt;br&gt;policy) apply to it?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#555555;strokeColor=none;fontColor=#FFFFFF;fontSize=17;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="585" y="340" width="330" height="100" as="geometry"/></mxCell><mxCell id="q3" value="Is it marked or identified&lt;br&gt;with its CUI category?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#555555;strokeColor=none;fontColor=#FFFFFF;fontSize=17;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="585" y="560" width="330" height="90" as="geometry"/></mxCell><mxCell id="o1" value="&lt;b style=&quot;font-size:22px&quot;&gt;Our own&lt;/b&gt;&lt;br&gt;Not CUI to us&lt;br&gt;Proprietary (own)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.04;fillColor=#2E8B57;strokeColor=none;fontColor=#FFFFFF;fontSize=15;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="330" height="110" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b style=&quot;font-size:22px&quot;&gt;Third party&lt;/b&gt;&lt;br&gt;Not CUI&lt;br&gt;Proprietary (third-party)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.04;fillColor=#5B7FA6;strokeColor=none;fontColor=#FFFFFF;fontSize=15;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="190" width="330" height="110" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b style=&quot;font-size:22px&quot;&gt;Potentially CUI&lt;/b&gt;&lt;br&gt;Notice sent" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.04;fillColor=#E8B923;strokeColor=none;fontColor=#FFFFFF;fontSize=15;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="330" height="110" as="geometry"/></mxCell><mxCell id="o4" value="&lt;b style=&quot;font-size:22px&quot;&gt;CUI&lt;/b&gt;&lt;br&gt;With its Registry category" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.04;fillColor=#9B6FB5;strokeColor=none;fontColor=#FFFFFF;fontSize=15;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="585" y="760" width="330" height="110" as="geometry"/></mxCell><mxCell id="o5" value="&lt;b style=&quot;font-size:22px&quot;&gt;Not CUI&lt;/b&gt;&lt;br&gt;FCI" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.04;fillColor=#777777;strokeColor=none;fontColor=#FFFFFF;fontSize=15;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="560" width="330" height="110" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;On every branch:&lt;/b&gt; export control is its own label. Run export-control-overlay whatever the CUI answer. Ownership removes CUI status; it does nothing for ITAR or EAR." style="rounded=1;arcSize=10;fillColor=#F2F2F2;strokeColor=#BBBBBB;fontColor=#333333;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="1380" height="60" as="geometry"/></mxCell><mxCell id="cap" value="CUI determination: who owns the data comes first. Steps refer to the cui-determination-workflow skill (ADR-0005, ADR-0006)." style="text;html=1;align=left;fontSize=13;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="1380" height="30" as="geometry"/></mxCell><mxCell id="e1" value="We do&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:13px&quot;&gt;(we created it and kept it)&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;strokeWidth=2;endArrow=block;endFill=1;fontSize=17;fontStyle=1;fontColor=#555555;labelBackgroundColor=#FFFFFF;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="q1" target="o1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="225" y="90"/></Array></mxGeometry></mxCell><mxCell id="e2" value="A third party&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:13px&quot;&gt;(commercial, not for the government)&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;strokeWidth=2;endArrow=block;endFill=1;fontSize=17;fontStyle=1;fontColor=#555555;labelBackgroundColor=#FFFFFF;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="q1" target="o2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1275" y="90"/></Array></mxGeometry></mxCell><mxCell id="e3" value="The government&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:13px&quot;&gt;(from DoD or an agency, directly or via a prime,&lt;br&gt;or a deliverable we owe them)&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;strokeWidth=2;endArrow=block;endFill=1;fontSize=17;fontStyle=1;fontColor=#555555;labelBackgroundColor=#FFFFFF;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;strokeWidth=2;endArrow=block;endFill=1;fontSize=17;fontStyle=1;fontColor=#555555;labelBackgroundColor=#FFFFFF;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="q2" target="o5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1275" y="390"/></Array></mxGeometry></mxCell><mxCell id="e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;strokeWidth=2;endArrow=block;endFill=1;fontSize=17;fontStyle=1;fontColor=#555555;labelBackgroundColor=#FFFFFF;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q2" target="q3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="No / unclear" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;strokeWidth=2;endArrow=block;endFill=1;fontSize=17;fontStyle=1;fontColor=#555555;labelBackgroundColor=#FFFFFF;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="q3" target="o3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;strokeWidth=2;endArrow=block;endFill=1;fontSize=17;fontStyle=1;fontColor=#555555;labelBackgroundColor=#FFFFFF;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q3" target="o4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>